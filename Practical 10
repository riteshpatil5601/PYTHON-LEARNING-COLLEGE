import matplotlib.pyplot as plt

# Data
subjects = ["Python", "Java", "C++", "JavaScript"]
marks = [85, 75, 90, 80]

# Line graph
plt.plot(subjects, marks, marker='o')
plt.title("Line Graph")
plt.xlabel("Subjects")
plt.ylabel("Marks")
plt.show()

# Bar graph
plt.bar(subjects, marks)
plt.title("Bar Graph")
plt.xlabel("Subjects")
plt.ylabel("Marks")
plt.show()

# Pie chart
plt.pie(marks, labels=subjects, autopct='%1.1f%%')
plt.title("Pie Chart")
plt.show()

# Scatter graph
plt.scatter(subjects, marks)
plt.title("Scatter Graph")
plt.xlabel("Subjects")
plt.ylabel("Marks")
plt.show()
